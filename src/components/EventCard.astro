---
import type { EventItem, Venue } from '../lib/data';
import type { Lang } from '../lib/config';
import { t, categoryName, locales } from '../lib/i18n';

interface Props {
  event: EventItem;
  venue?: Venue;
  lang: Lang;
  timezone: string;
}
const { event, venue, lang, timezone } = Astro.props;
const s = t(lang);
const loc = locales[lang];

const time = event.all_day
  ? null
  : new Intl.DateTimeFormat(loc, { hour: '2-digit', minute: '2-digit', timeZone: timezone }).format(new Date(event.start));
const until = event.end
  ? new Intl.DateTimeFormat(loc, { day: 'numeric', month: 'short', timeZone: timezone }).format(new Date(event.end))
  : null;
const price = event.price.free === true
  ? s.free
  : event.price.free === false
    ? (event.price.text ?? (event.price.min != null ? `${event.price.min} €` : ''))
    : s.priceUnknown;
const freeFlag = event.price.free === true ? '1' : event.price.free === false ? '0' : '?';
const venueName = venue?.name ?? event.venue_id;
---
<article
  class="event"
  data-category={event.category}
  data-free={freeFlag}
  data-start={event.start}
  data-end={event.end ?? event.start}
  data-search={`${event.title} ${venueName}`.toLowerCase()}
>
  <div class="event-time">
    {time ? <time datetime={event.start}>{time}</time> : <span class="muted">—</span>}
  </div>
  <div class="event-body">
    <span class={`cat cat-${event.category}`}>{categoryName(lang, event.category)}</span>
    <h3 class="event-title">
      <a href={event.url} target="_blank" rel="noopener nofollow">{event.title}</a>
    </h3>
    <p class="event-meta">
      <span class="venue">{venueName}</span>
      {until && <span class="until"> · {s.until} {until}</span>}
    </p>
  </div>
  <div class="event-side">
    <span class:list={['price', { free: event.price.free === true, unknown: event.price.free == null }]}>{price}</span>
    <a class="source-link" href={event.url} target="_blank" rel="noopener nofollow">{s.source} ↗</a>
  </div>
</article>
