---
import '../styles/global.css';
import { SITE_NAME, SAMPLE_DATA, LANGS, url, type Lang } from '../lib/config';
import { t } from '../lib/i18n';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  /** Ruta de esta página sin el prefijo de idioma, p. ej. "granada/" */
  path: string;
}
const { lang, title, description, path } = Astro.props;
const s = t(lang);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={url(`${l}/${path}`)} />)}
    <meta name="theme-color" content="#b3263e" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-row">
        <a class="brand" href={url(`${lang}/${path}`)}>
          <img src={url('favicon.svg')} alt="" width="28" height="28" />
          <span>{SITE_NAME}</span>
        </a>
        <nav class="lang-switch" aria-label={s.language}>
          {LANGS.map((l) => (
            <a href={url(`${l}/${path}`)} aria-current={l === lang ? 'true' : undefined} lang={l}>{l.toUpperCase()}</a>
          ))}
        </nav>
      </div>
    </header>
    {SAMPLE_DATA && <p class="sample-notice">{s.sampleNotice}</p>}
    <main class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>{s.footerData}</p>
        <p>© {new Date().getFullYear()} {SITE_NAME}</p>
      </div>
    </footer>
  </body>
</html>
